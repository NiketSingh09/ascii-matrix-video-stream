import cv2
import numpy as np

ASCII_CHARS = ["@", "#", "$", "%", "?", "*", "+", ";", ":", ",", ".", " "]
FONT = cv2.FONT_HERSHEY_PLAIN

def frame_to_ascii_image(frame, width=90):
    h, w, _ = frame.shape
    aspect_ratio = h / w
    new_height = int(width * aspect_ratio * 0.55)
    resized_frame = cv2.resize(frame, (width, new_height))
    
    gray_frame = cv2.cvtColor(resized_frame, cv2.COLOR_BGR2GRAY)
    
    canvas_w = width * 10
    canvas_h = new_height * 14
    canvas = np.zeros((canvas_h, canvas_w, 3), dtype=np.uint8)
    
    char_step = 256 / len(ASCII_CHARS)
    for y in range(new_height):
        for x in range(width):
            pixel_val = gray_frame[y, x]
            char_idx = int(pixel_val / char_step)
            char = ASCII_CHARS[min(char_idx, len(ASCII_CHARS) - 1)]
            
            # Green text (B, G, R)
            cv2.putText(canvas, char, (x * 10, y * 14 + 10), FONT, 0.7, (0, 255, 0), 1)
            
    return canvas

def main():
    cap = cv2.VideoCapture(0)
    window_name = "Real-Time ASCII Matrix Stream"
    
    cv2.namedWindow(window_name, cv2.WINDOW_AUTOSIZE)
    print("---------------------------------------")
    print("Click ON the video window to focus it.")
    print("Press 'q', 'ESC', or click the 'X' button to quit.")
    print("---------------------------------------")
    
    while True:
        ret, frame = cap.read()
        if not ret:
            print("Failed to access camera.")
            break
            
        ascii_canvas = frame_to_ascii_image(frame, width=90)
        cv2.imshow(window_name, ascii_canvas)
        
        # 1. Exit if user clicks the 'X' button on the window
        if cv2.getWindowProperty(window_name, cv2.WND_PROP_VISIBLE) < 1:
            break
            
        # 2. Check keypress (q, Q, or ESC)
        key = cv2.waitKey(1) & 0xFF
        if key in [ord('q'), ord('Q'), 27]:  # 27 = ESC key
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
